+    def _refuse_drop_that_leaves_references(self) -> None:
+        """ROUGH: refuse drop tables that another table still names, by foreign key or by a parent
+        its factory's inventory_spec declares, naming the tables and every table that must also
+        go, before the primary is created or opened."""
+        if not self._drop_tables:
+            return
+        dropped = set(self._drop_tables)
+        needed = ShardedPool._tables_naming(dropped, self._factories)
+        if len(needed) > 0:
+            raise RuntimeError(
+                f'Cannot open sharded datastore "{str(self._primary_file)}": dropping '
+                f"{sorted(dropped)} would leave rows of {sorted(needed)} naming rows that are "
+                f"gone; drop those tables too. Nothing was opened"
+            )
+
+    @staticmethod
+    def _tables_naming(dropped, factories):
+        tables = build_schema(sqla.MetaData(), factories).tables
+        names = {
+            name: {fk.column.table.name for fk in t.foreign_keys} - {name}
+            for name, t in tables.items()
+        }
+        for cls, spec in inventory_specs(factories).items():
+            names.setdefault(cls, set()).update(set(spec.dependencies()) - {cls})
+        gone = set(dropped)
+        needed = set()
+        while True:
+            more = {n for n, refs in names.items() if n not in gone and refs & gone}
+            if not more:
+                return needed
+            needed |= more
+            gone |= more
+
