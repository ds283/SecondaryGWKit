index 0000000..0c56b8f
--- /dev/null
+++ b/Datastore/tests/test_layer_registry.py
@@ -0,0 +1,311 @@
+"""
+SKETCH (measure-06): the datastore layer is given its registry (prompts/datastore-generic,
+prompt 06). Not a finished test module: it shows the tests the prompt should require.
+
+1. ``TestTablesToDrop`` -- ``config.datastore.tables_to_drop``.
+2. ``TestSerialBatchSizes`` -- ``SerialPoolManager`` takes its batch sizes; 500 otherwise.
+3. ``TestDropOrderOnAFullStore`` -- under ``PRAGMA foreign_keys = ON``, the real
+   ``Datastore._drop_tables`` drops every group from every shard of ``build_full_store`` (rows in
+   every dropped table), and leaves no foreign-key violation.
+4. ``TestAnUndeclaredDropTable`` -- the pool refuses it by name before anything is opened.
+5. ``TestTheRecordedReplicatedSet`` -- the reader yields the primary's recorded set, and refuses a
+   primary whose set cannot be read or names an undeclared class; the inventory uses it.
+6. ``TestThePoolUsesItsRegistry`` -- a pool given a smaller registry builds only its tables.
+7. ``TestTheLayerImportsNoClient`` -- importing the layer loads no client module.
+
+No Ray, nothing under ``var/``.
+"""
+
+import ast
+import json
+import os
+import shutil
+import sqlite3
+import subprocess
+import sys
+import tempfile
+import types
+import unittest
+from pathlib import Path
+from unittest import mock
+
+import ray
+import sqlalchemy as sqla
+
+from Datastore.SQL.ClientPool import SerialPoolManager
+from Datastore.SQL.schema import build_schema
+from Datastore.store_inventory import read_inventory
+from Datastore.store_reader import open_read_only
+from Datastore.tests import standin_pool as sp
+from Datastore.tests.real_store_fixtures import build_full_store, file_state
+from config.datastore import drop_groups, factories, tables_to_drop
+from config.sharding import replicated_tables as configured_replicated
+
+REPO_ROOT = Path(__file__).resolve().parents[2]
+
+
+class _Temp(unittest.TestCase):
+    def setUp(self):
+        tmp = tempfile.TemporaryDirectory()
+        self.addCleanup(tmp.cleanup)
+        self.root = Path(tmp.name)
+
+
+class TestTablesToDrop(unittest.TestCase):
+    def test_each_table_once_in_group_order(self):
+        self.assertEqual(
+            tables_to_drop(["tk-wkb", "tk-wkb"]),
+            ["TkWKBIntegration", "TkWKB_tags", "TkWKBValue"],
+        )
+        names = tables_to_drop(list(drop_groups))
+        self.assertEqual(len(names), len(set(names)))
+        self.assertEqual(set(names), {t for g in drop_groups.values() for t in g})
+
+    def test_an_unknown_action_is_named(self):
+        with self.assertRaises(ValueError) as ctx:
+            tables_to_drop(["tk-wkb", "no-such-group"])
+        self.assertIn("no-such-group", str(ctx.exception))
+
+    def test_every_drop_table_is_declared(self):
+        tables = build_schema(sqla.MetaData(), factories).tables
+        self.assertLessEqual(set(tables_to_drop(list(drop_groups))), set(tables))
+
+
+class TestSerialBatchSizes(unittest.TestCase):
+    def _batch(self, manager, table):
+        seen = {}
+
+        class Recording:
+            def __init__(self, table, profiler, broker, default_batch_size):
+                seen[table] = default_batch_size
+
+            def lease_serial(self):
+                return 1
+
+        with mock.patch("Datastore.SQL.ClientPool.ClientPool", Recording):
+            manager.lease_serial(table)
+        return seen[table]
+
+    def test_the_given_sizes_and_the_default(self):
+        given = SerialPoolManager(
+            profiler=None, broker=object(), batch_sizes={"TkNumericValue": 7}
+        )
+        self.assertEqual(self._batch(given, "TkNumericValue"), 7)
+        self.assertEqual(self._batch(given, "redshift"), 500)
+        none = SerialPoolManager(profiler=None, broker=object())
+        self.assertEqual(self._batch(none, "TkNumericValue"), 500)
+
+    def test_the_layer_holds_no_table_of_sizes(self):
+        import Datastore.SQL.ClientPool as cp
+
+        self.assertFalse(hasattr(cp, "_default_serial_batch_size"))
+
+
+class TestDropOrderOnAFullStore(_Temp):
+    def _drop_all(self, shard: Path):
+        engine = sqla.create_engine(f"sqlite:///{shard}", future=True)
+
+        @sqla.event.listens_for(engine, "connect")
+        def _enforce(dbapi_connection, connection_record):
+            dbapi_connection.execute("PRAGMA foreign_keys = ON")
+
+        metadata = sqla.MetaData()
+        tables = build_schema(metadata, factories).tables
+        fake = types.SimpleNamespace(
+            _inspector=sqla.inspect(engine),
+            _tables=tables,
+            _engine=engine,
+            _metadata=metadata,
+            _my_name="drop-test",
+        )
+        with mock.patch("builtins.print"):
+            sp.DatastoreClass._drop_tables(fake, tables_to_drop(list(drop_groups)))
+        with engine.connect() as conn:
+            self.assertEqual(conn.execute(sqla.text("PRAGMA foreign_keys")).scalar(), 1)
+            left = set(sqla.inspect(engine).get_table_names())
+            violations = conn.execute(sqla.text("PRAGMA foreign_key_check")).all()
+        engine.dispose()
+        return left, violations
+
+    def test_every_group_drops_from_a_store_holding_rows(self):
+        store = build_full_store(self.root)
+        dropped = set(tables_to_drop(list(drop_groups)))
+        for sid, path in sorted(store.shard_files.items()):
+            with self.subTest(shard=sid):
+                with sqlite3.connect(path) as c:
+                    held = {
+                        t
+                        for t in dropped
+                        if c.execute(f'SELECT count(*) FROM "{t}"').fetchone()[0]
+                    }
+                self.assertTrue(held)  # the drop is exercised against rows
+                left, violations = self._drop_all(path)
+                self.assertEqual(left & dropped, set())
+                self.assertEqual(violations, [])
+
+    def test_an_unsorted_drop_is_refused_by_enforcement(self):
+        store = build_full_store(self.root)
+        with mock.patch.object(sqla.schema, "sort_tables", lambda tables: list(tables)):
+            with self.assertRaises(sqla.exc.IntegrityError):
+                self._drop_all(store.shard_files[0])
+
+
+class TestAnUndeclaredDropTable(_Temp):
+    def test_refused_before_anything_is_opened(self):
+        cluster = sp.StandinCluster()
+        with cluster.active():
+            built = self.root / "pool" / "store.sqlite"
+            cluster.close_pool(cluster.open_pool(built))
+            before = sp.store_checksums(built)
+            missing = self.root / "nowhere" / "store.sqlite"
+            for read_only in (False, True):
+                for primary in (missing, built):
+                    with self.subTest(read_only=read_only, primary=primary.parent.name):
+                        cluster.calls.clear()
+                        with self.assertRaises(RuntimeError) as ctx:
+                            cluster.open_pool(
+                                primary,
+                                read_only=read_only,
+                                drop_tables=["GkSource", "NotATable"],
+                            )
+                        self.assertIn("NotATable", str(ctx.exception))
+                        self.assertNotIn("'GkSource'", str(ctx.exception))
+                        self.assertEqual(cluster.calls, [])
+                        self.assertFalse(missing.parent.exists())
+                        self.assertEqual(sp.store_checksums(built), before)
+
+
+class TestTheRecordedReplicatedSet(_Temp):
+    def _primary_sql(self, store, *statements):
+        with sqlite3.connect(store.primary) as c:
+            for s in statements:
+                c.execute(s)
+
+    def test_the_reader_yields_the_recorded_set_in_serial_order(self):
+        store = build_full_store(self.root)
+        # reorder the serials: the yield follows them, not config.sharding
+        self._primary_sql(
+            store,
+            "UPDATE replicated_tables SET serial = 100 - serial",
+        )
+        with open_read_only(store.primary, factories) as opened:
+            self.assertEqual(
+                opened.replicated_tables, tuple(reversed(configured_replicated))
+            )
+
+    def test_an_unreadable_set_is_refused(self):
+        store = build_full_store(self.root)
+        self._primary_sql(store, "DROP TABLE replicated_tables")
+        before = file_state(store.directory)
+        for read in (
+            lambda: open_read_only(store.primary, factories).__enter__(),
+            lambda: read_inventory(store.primary, factories),
+        ):
+            with self.assertRaises(RuntimeError) as ctx:
+                read()
+            self.assertIn("replicated_tables", str(ctx.exception))
+            self.assertTrue(
+                str(ctx.exception).startswith("Cannot read sharded datastore")
+            )
+        self.assertEqual(file_state(store.directory), before)
+
+    def test_an_undeclared_class_is_refused(self):
+        store = build_full_store(self.root)
+        self._primary_sql(
+            store,
+            "INSERT INTO replicated_tables (serial, \"table\") VALUES (99, 'NotAClass')",
+        )
+        with self.assertRaises(RuntimeError) as ctx:
+            read_inventory(store.primary, factories)
+        self.assertIn("NotAClass", str(ctx.exception))
+
+    def test_the_inventory_uses_the_recorded_set(self):
+        store = build_full_store(self.root)
+        self._primary_sql(
+            store, "DELETE FROM replicated_tables WHERE \"table\" = 'tolerance'"
+        )
+        inventory = read_inventory(store.primary, factories)
+        self.assertFalse(inventory["tolerance"].replicated)
+        self.assertTrue(inventory["redshift"].replicated)
+
+    def test_the_inventory_names_no_configuration(self):
+        tree = ast.parse((REPO_ROOT / "Datastore" / "store_inventory.py").read_text())
+        modules = {
+            n.module
+            for n in ast.walk(tree)
+            if isinstance(n, ast.ImportFrom) and n.module
+        }
+        self.assertFalse({m for m in modules if m.split(".")[0] == "config"})
+
+
+class TestThePoolUsesItsRegistry(_Temp):
+    def test_a_smaller_registry_builds_only_its_tables(self):
+        small = {
+            k: v
+            for k, v in factories.items()
+            if k not in ("OneLoopIntegral", "OneLoopIntegral_tags")
+        }
+        cluster = sp.StandinCluster()
+        with cluster.active():
+            primary = self.root / "store.sqlite"
+            pool = cluster.open_pool(primary, factories=small)
+            self.assertEqual(pool.factories, small)
+            files = dict(pool._shard_db_files)
+            cluster.close_pool(pool)
+        for path in files.values():
+            names = {
+                r[0]
+                for r in sp._read(
+                    path, "SELECT name FROM sqlite_master WHERE type='table'"
+                )
+            }
+            self.assertNotIn("OneLoopIntegral", names)
+            self.assertIn("QuadSourceIntegral", names)
+
+
+_LAYER = [
+    "Datastore.SQL.ShardedPool",
+    "Datastore.SQL.Datastore",
+    "Datastore.SQL.ClientPool",
+    "Datastore.store_reader",
+    "Datastore.store_inventory",
+]
+# what the layer may still load: config.defaults (a generic constant), the factories' base class,
+# and MetadataConcepts until prompt 07 (U4)
+_ALLOWED = {
+    "config",
+    "config.defaults",
+    "Datastore.SQL.ObjectFactories",
+    "Datastore.SQL.ObjectFactories.base",
+}
+
+
+class TestTheLayerImportsNoClient(unittest.TestCase):
+    def test_a_fresh_interpreter(self):
+        code = (
+            "import json, sys, importlib\n"
+            f"for m in {_LAYER!r}: importlib.import_module(m)\n"
+            "print(json.dumps(sorted(sys.modules)))\n"
+        )
+        result = subprocess.run(
+            [sys.executable, "-c", code],
+            cwd=str(REPO_ROOT),
+            env=dict(os.environ, PYTHONPATH=str(REPO_ROOT)),
+            capture_output=True,
+            text=True,
+            timeout=300,
+        )
+        self.assertEqual(result.returncode, 0, result.stderr)
+        loaded = json.loads(result.stdout.strip().splitlines()[-1])
+        client = [
+            m
+            for m in loaded
+            if m.split(".")[0]
+            in ("config", "ComputeTargets", "CosmologyConcepts", "CosmologyModels")
+            or m.startswith("Datastore.SQL.ObjectFactories")
+        ]
+        self.assertEqual(sorted(set(client) - _ALLOWED), [])
+
+
+if __name__ == "__main__":
+    unittest.main()
