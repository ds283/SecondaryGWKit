diff --git a/Datastore/SQL/schema.py b/Datastore/SQL/schema.py
index 226a947..0fefa50 100644
--- a/Datastore/SQL/schema.py
+++ b/Datastore/SQL/schema.py
@@ -133,3 +133,81 @@ def build_schema(metadata: sqla.MetaData, factories: Mapping[str, Any]) -> Built
         records[cls_name] = schema
 
     return BuiltSchema(tables=tables, records=records)
+
+
+class SchemaDifferences(NamedTuple):
+    """What ``schema_differences`` finds in one SQLite file: names only."""
+
+    absent_tables: list
+    extra_tables: list
+    absent_columns: Dict[str, list]
+    extra_columns: Dict[str, list]
+
+    @property
+    def empty(self) -> bool:
+        return not (
+            self.absent_tables
+            or self.extra_tables
+            or self.absent_columns
+            or self.extra_columns
+        )
+
+
+def schema_differences(conn, tables: Mapping[str, sqla.Table]) -> SchemaDifferences:
+    """Compare one SQLite file's tables and columns, by name, with ``tables``."""
+    in_file = [
+        row[0]
+        for row in conn.exec_driver_sql(
+            "SELECT name FROM sqlite_master WHERE type = 'table' ORDER BY name"
+        )
+        if not row[0].startswith("sqlite_")
+    ]
+    absent_tables = [n for n in tables if n not in in_file]
+    extra_tables = [n for n in in_file if n not in tables]
+    absent_columns: Dict[str, list] = {}
+    extra_columns: Dict[str, list] = {}
+    for name, table in tables.items():
+        if name not in in_file:
+            continue
+        quoted = name.replace('"', '""')
+        file_columns = [
+            row[1] for row in conn.exec_driver_sql(f'PRAGMA table_info("{quoted}")')
+        ]
+        declared = [c.name for c in table.columns]
+        a = [c for c in declared if c not in file_columns]
+        e = [c for c in file_columns if c not in declared]
+        if a:
+            absent_columns[name] = a
+        if e:
+            extra_columns[name] = e
+    return SchemaDifferences(absent_tables, extra_tables, absent_columns, extra_columns)
+
+
+class StoreSchemaMismatch(RuntimeError):
+    """A file of a store whose tables or columns differ from what the code declares."""
+
+    def __init__(
+        self, primary, file_desc: str, differences: SchemaDifferences, verb="open"
+    ):
+        self.primary = primary
+        self.file_desc = file_desc
+        self.differences = differences
+        parts = []
+        if differences.absent_tables:
+            parts.append(f"it lacks the table(s) {differences.absent_tables}")
+        if differences.extra_tables:
+            parts.append(
+                f"it has the table(s) {differences.extra_tables}, which the code does not declare"
+            )
+        for t, cols in differences.absent_columns.items():
+            parts.append(f"its table {t} lacks the column(s) {cols}")
+        for t, cols in differences.extra_columns.items():
+            parts.append(
+                f"its table {t} has the column(s) {cols}, which the code does not declare"
+            )
+        super().__init__(
+            f'Cannot {verb} sharded datastore "{str(primary)}": {file_desc} does not have the '
+            f"schema the code declares: "
+            + "; ".join(parts)
+            + ". Nothing was read or repaired"
+        )
