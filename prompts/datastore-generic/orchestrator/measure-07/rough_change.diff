@@ -0,0 +1,21 @@
+"""
+The tables and columns the datastore layer owns as its contract (prompts/datastore-generic,
+prompt 07; README §6.2, U4).
+
+Every storable row carries a foreign key to the version table's serial, and every tagged class
+associates its rows with the tag table. These are not a project's choice: the layer names them,
+once, here. The client registers a factory under each name, and the layer builds their objects
+through those factories.
+
+Standard library only, so that any module of the layer can import it at module scope.
+"""
+
+# the version table: its name, and the column holding the label a pool is opened under
+VERSION_TABLE = "version"
+VERSION_LABEL = "label"
+
+# the tag table: its name, the column holding a tag's label, and the column of an association
+# table naming a tag
+TAG_TABLE = "store_tag"
+TAG_LABEL = "label"
+TAG_SERIAL = "tag_serial"
