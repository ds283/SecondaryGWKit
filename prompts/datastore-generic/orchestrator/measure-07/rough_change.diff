+"""
+The replication facts the factories declare (prompts/datastore-generic, prompt 07). SKETCH.
+
+1. ``build_schema`` carries ``owner_column``, ``monotone_flags`` and ``validated_column`` into the
+   records, with defaults, and refuses a bad declaration by class name;
+2. ``ShardedPool._unit_tables``: BackgroundModel's three tables, every other compared table alone;
+3. the declared monotone flags reach the specs;
+4. ``revalidate`` agrees with ``validate`` on the same stored rows;
+5. the version object is built through the version table's factory, as before;
+6. ``owned_serials``;
+7. no registry table name or project package in ``ShardedPool.py`` but the contract's.
+
+No Ray, nothing under ``var/``.
+"""
+
+import contextlib
+import io
+import re
+import tempfile
+import unittest
+from pathlib import Path
+
+import sqlalchemy as sqla
+
+from config.datastore import factories
+from config.sharding import replicated_tables, sharded_tables
+from Datastore.contract import TAG_TABLE, VERSION_TABLE
+from Datastore.object import DatastoreObject
+from Datastore.SQL.ObjectFactories.base import SQLAFactoryBase
+from Datastore.SQL.schema import build_schema
+from Datastore.tests import standin_pool as sp
+
+REPO_ROOT = Path(__file__).resolve().parents[2]
+ShardedPool = sp.sp_mod.ShardedPool
+
+DECLARED = {
+    "redshift": (None, ("source", "response"), None),
+    "wavenumber": (None, ("source", "response"), None),
+    "BackgroundModel": (None, (), "validated"),
+    "BackgroundModelValue": ("model_serial", (), None),
+}
+
+
+def specs_of_the_registry():
+    built = build_schema(sqla.MetaData(), factories)
+    pool = object.__new__(ShardedPool)
+    pool._replicated_tables = list(replicated_tables)
+    pool._sharded_tables = dict(sharded_tables)
+    pool._factories = dict(factories)
+    return built, pool._replicated_table_specs(built)
+
+
+class _Owner:
+    @staticmethod
+    def register():
+        return {"version": False, "timestamp": False, "columns": []}
+
+
+def _member(**declared):
+    class _Member:
+        @staticmethod
+        def register():
+            return {
+                "version": False,
+                "timestamp": False,
+                "columns": [
+                    sqla.Column("plain", sqla.Integer),
+                    sqla.Column(
+                        "owner_serial", sqla.Integer, sqla.ForeignKey("Owner.serial")
+                    ),
+                    sqla.Column(
+                        "two_keys",
+                        sqla.Integer,
+                        sqla.ForeignKey("Owner.serial"),
+                        sqla.ForeignKey("Other.serial"),
+                    ),
+                    sqla.Column("flag", sqla.Boolean),
+                ],
+                **declared,
+            }
+
+    return _Member
+
+
+# 1 ---------------------------------------------------------------------------------------------
+
+
+class TestBuildSchemaCarriesTheKeys(unittest.TestCase):
+    def test_the_registry_declares_exactly_these(self):
+        built = build_schema(sqla.MetaData(), factories)
+        for name, record in built.records.items():
+            with self.subTest(cls=name):
+                got = (
+                    record["owner_column"],
+                    record["monotone_flags"],
+                    record["validated_column"],
+                )
+                self.assertEqual(DECLARED.get(name, (None, (), None)), got)
+
+    def test_a_record_with_no_table_is_unchanged(self):
+        class _NoTable:
+            @staticmethod
+            def register():
+                return None
+
+        built = build_schema(sqla.MetaData(), {"NoTable": _NoTable})
+        self.assertEqual(
+            {"name": "NoTable", "validate_on_startup": False, "table": None},
+            built.records["NoTable"],
+        )
+
+
+class TestBuildSchemaRefuses(unittest.TestCase):
+    CASES = {
+        "an absent owner_column": ({"owner_column": "nonesuch"}, "nonesuch"),
+        "an owner_column with no foreign key": ({"owner_column": "plain"}, "0 foreign"),
+        "an owner_column with two foreign keys": (
+            {"owner_column": "two_keys"},
+            "2 foreign",
+        ),
+        "an absent monotone flag": (
+            {"monotone_flags": ("flag", "nonesuch")},
+            "nonesuch",
+        ),
+        "an absent validated_column": ({"validated_column": "nonesuch"}, "nonesuch"),
+    }
+
+    def test_each_refusal_names_the_class_and_the_column(self):
+        for case, (declared, fragment) in self.CASES.items():
+            with self.subTest(case=case):
+                with self.assertRaises(ValueError) as raised:
+                    build_schema(
+                        sqla.MetaData(),
+                        {
+                            "Owner": _Owner,
+                            "Other": _Owner,
+                            "Member": _member(**declared),
+                        },
+                    )
+                self.assertIn('"Member"', str(raised.exception))
+                self.assertIn(fragment, str(raised.exception))
+
+
+# 2, 3 ------------------------------------------------------------------------------------------
+
+
+class TestUnitTables(unittest.TestCase):
+    def test_every_compared_table(self):
+        _, specs = specs_of_the_registry()
+        for spec in specs:
+            name = spec["name"]
+            with self.subTest(cls=name):
+                expected = (
+                    ["BackgroundModel", "BackgroundModel_tags", "BackgroundModelValue"]
+                    if name == "BackgroundModel"
+                    else [name]
+                )
+                self.assertEqual(expected, ShardedPool._unit_tables(name, specs))
+
+    def test_the_declared_flags_reach_the_specs(self):
+        _, specs = specs_of_the_registry()
+        flags = {s["name"]: s["monotone_flags"] for s in specs if s["monotone_flags"]}
+        self.assertEqual(
+            {"redshift": ("source", "response"), "wavenumber": ("source", "response")},
+            flags,
+        )
+
+
+# 4 ---------------------------------------------------------------------------------------------
+
+
+class _StoredModel(DatastoreObject):
+    """HEAD's stand-in in _recompute_validated: what validate reads of a model."""
+
+    def __init__(self, store_id, label):
+        super().__init__(store_id)
+        self.label = label
+
+
+class TestRevalidateIsValidate(unittest.TestCase):
+    @classmethod
+    def setUpClass(cls):
+        from Datastore.tests.real_store_fixtures import build_full_store
+
+        cls._tmp = tempfile.TemporaryDirectory()
+        root = Path(cls._tmp.name)
+        with contextlib.redirect_stdout(io.StringIO()):
+            build_full_store(root)
+        cls.shard = next(root.glob("*shard0000*.sqlite"))
+
+    @classmethod
+    def tearDownClass(cls):
+        cls._tmp.cleanup()
+
+    def call(self, conn, built, how, serial, label, short):
+        table = built.tables["BackgroundModel"]
+        values = built.tables["BackgroundModelValue"]
+        factory = factories["BackgroundModel"]
+        savepoint = conn.begin_nested()
+        try:
+            if short:
+                victim = conn.execute(
+                    sqla.select(sqla.func.max(values.c.serial)).filter(
+                        values.c.model_serial == serial
+                    )
+                ).scalar()
+                conn.execute(sqla.delete(values).where(values.c.serial == victim))
+            out = io.StringIO()
+            with contextlib.redirect_stdout(out):
+                if how == "validate":
+                    result = factory.validate(
+                        _StoredModel(serial, label),
+                        conn=conn,
+                        table=table,
+                        tables=built.tables,
+                    )
+                else:
+                    result = factory.revalidate(serial, conn, table, built.tables)
+            written = conn.execute(
+                sqla.select(table.c.validated).filter(table.c.serial == serial)
+            ).scalar()
+            return result, written, out.getvalue()
+        finally:
+            savepoint.rollback()
+
+    def test_the_same_answer_flag_and_warning(self):
+        built = build_schema(sqla.MetaData(), factories)
+        table = built.tables["BackgroundModel"]
+        engine = sqla.create_engine(f"sqlite:///{self.shard}", future=True)
+        try:
+            with engine.connect() as conn:
+                models = conn.execute(sqla.select(table.c.serial, table.c.label)).all()
+                self.assertGreater(len(models), 0)
+                for serial, label in models:
+                    for short in (False, True):
+                        with self.subTest(serial=serial, short=short):
+                            a = self.call(conn, built, "validate", serial, label, short)
+                            b = self.call(
+                                conn, built, "revalidate", serial, label, short
+                            )
+                            self.assertEqual(a, b)
+                            self.assertEqual(not short, a[0])
+                conn.rollback()
+        finally:
+            engine.dispose()
+
+    def test_the_base_refuses(self):
+        with self.assertRaises(NotImplementedError):
+            SQLAFactoryBase.revalidate(1, None, None, None)
+
+
+# 5 ---------------------------------------------------------------------------------------------
+
+
+class TestTheVersionObject(unittest.TestCase):
+    def test_built_by_the_factory_with_the_attributes_it_had(self):
+        built_by = []
+        version_factory = factories[VERSION_TABLE]
+
+        class _Recording(version_factory):
+            @staticmethod
+            def build(payload, conn, table, inserter, tables, inserters):
+                built_by.append(dict(payload))
+                return version_factory.build(
+                    payload, conn, table, inserter, tables, inserters
+                )
+
+        registry = dict(factories)
+        registry[VERSION_TABLE] = _Recording
+        with tempfile.TemporaryDirectory() as d:
+            primary = Path(d) / "store.sqlite"
+            cluster = sp.StandinCluster()
+            with cluster.active():
+                pool = cluster.open_pool(primary, factories=registry)
+                fresh = pool._version
+                cluster.close_pool(pool)
+                for read_only in (False, True):
+                    built_by.clear()
+                    pool = cluster.open_pool(
+                        primary, factories=registry, read_only=read_only
+                    )
+                    v = pool._version
+                    cluster.close_pool(pool)
+                    with self.subTest(read_only=read_only):
+                        # the pool's own build, on the lowest-serial shard: one call
+                        self.assertIn({"label": "standin"}, built_by)
+                        self.assertEqual(type(fresh), type(v))
+                        self.assertEqual(
+                            {"_my_id": 1, "_label": "standin", "_deserialized": True},
+                            vars(v),
+                        )
+
+
+# 6 ---------------------------------------------------------------------------------------------
+
+
+class TestOwnedSerials(unittest.TestCase):
+    def test_the_base_owns_nothing(self):
+        self.assertIsNone(SQLAFactoryBase.owned_serials(object()))
+
+    def test_a_model_names_its_value_rows(self):
+        class _Row:
+            def __init__(self, serial):
+                self._my_id = serial
+
+        class _Model:
+            _values = [_Row(3), _Row(None), _Row(5)]
