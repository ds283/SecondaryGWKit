+def _e07c_estimate(x_span, f, BasisData, chebyshev_order, value_fine, integrand_fine, vectorize_cache):
+    """07c variant (E): the sharper estimate of CC_{2N-1}'s error (see make_variants_07c.py)."""
+    kind = _E07C[1]
+    if kind == "nest3":
+        order3 = 4 * chebyshev_order - 3
+        grid3, _ = chebyshev_matrices(x_span, order3)
+        f3 = np.vstack([_sample_vectorized(func, grid3, vectorize_cache, ("f", id(func))) for func in f])
+        basis3 = np.array([BasisData.eval_basis_and_arguments(x)[0] for x in grid3]).T
+        value3 = float(np.dot(_cc_weights(x_span, order3), np.sum(f3 * basis3, axis=0)))
+        return float(np.fabs(value3 - value_fine))
+    if kind == "tail_sum4":
+        n = integrand_fine.shape[0]
+        j = np.arange(n)
+        wts = np.ones(n)
+        wts[0] = wts[-1] = 0.5
+        ck = np.array([(2.0 / (n - 1)) * np.sum(wts * integrand_fine * np.cos(np.pi * j * k / (n - 1))) for k in range(n - 4, n)])
+        ck[-1] *= 0.5
+        return float(0.5 * np.fabs(x_span[1] - x_span[0]) * np.sum(np.abs(ck)))
+    raise RuntimeError("07c variant (E): unknown estimate")
+
