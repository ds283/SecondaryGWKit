+    split_out = {}
+    for part in PARTS:
+        rr = np.array(split.get(part, []))
+        if not len(rr):
+            print(f"   {part:12s} points 0")
+            split_out[part] = {"n": 0}
+            continue
+        split_out[part] = {
+            "n": int(len(rr)),
+            "median": float(np.median(rr)),
+            "p90": float(np.quantile(rr, 0.9)),
+            "max": float(rr.max()),
+            "min": float(rr.min()),
+        }
+        print(
+            f"   {part:12s} points {len(rr):5d}; median {np.median(rr):.3e}; 90 % {np.quantile(rr, 0.9):.3e}; "
+            f"max {rr.max():.3e}; min {rr.min():.3e}"
+        )
+
+    # ---------------- H2
+    print("\n== H2 -- the declared term covers the response (h's returned leaves)")
+    leafrows = []
+    for c in calls:
+        for t in ("h", "p"):
+            for L in c[f"res_{t}"]["M2"]["per_leaf"]:
+                dec = L["declared"]
+                resp = abs(L["dI_measured"])
+                leafrows.append(
+                    {
+                        "tree": t,
+                        "unit_06f": c["unit_06f"],
+                        "index": c["key"][1],
+                        "label": c["label"],
+                        "leaf": L["i"],
+                        "branch": L["branch"],
+                        "a": L["a"],
+                        "b": L["b"],
+                        "depth": L["depth"],
+                        "declared": dec,
+                        "abs_dI_measured": resp,
+                        "ratio": (
+                            (resp / dec)
+                            if dec > 0
+                            else (float("inf") if resp > 0 else 0.0)
+                        ),
+                        "abs_dI_measured_float": abs(L["dI_measured_float"]),
+                        "max_abs_delta_theta": L["max_abs_delta_theta"],
+                        "theta_abserr_a": L["theta_abserr_a"],
+                        "theta_abserr_b": L["theta_abserr_b"],
+                    }
+                )
+    hl = [r for r in leafrows if r["tree"] == "h"]
+    pl = [r for r in leafrows if r["tree"] == "p"]
+    H2 = all(r["abs_dI_measured"] <= r["declared"] for r in hl)
+    wl = max(hl, key=lambda r: r["ratio"])
+    med = statistics.median(r["ratio"] for r in hl)
+    pv = [r for r in pl if r["abs_dI_measured"] > r["declared"]]
+    wpl = max(pl, key=lambda r: r["ratio"])
+    print(
+        f"   leaves scored {len(hl)} ({sum(1 for r in hl if r['branch'] == 'levin')} Levin); violating "
+        f"{sum(1 for r in hl if r['abs_dI_measured'] > r['declared'])} -> H2 {'holds' if H2 else 'fails'}"
+    )
+    print(
+        f"   worst |dI_measured|/declared = {wl['ratio']:.6g} on {wl['unit_06f']} #{wl['index']} leaf {wl['leaf']} "
+        f"({wl['branch']}, depth {wl['depth']}): {wl['abs_dI_measured']:.4e} against {wl['declared']:.4e}; median {med:.4g}"
+    )
+    print(
+        f"   the parent (its own leaves, its own declared terms): {len(pl)} leaves, violating {len(pv)}, worst "
+        f"{wpl['ratio']:.6g} on {wpl['unit_06f']} #{wpl['index']} leaf {wpl['leaf']} ({wpl['branch']}); median "
+        f"{statistics.median(r['ratio'] for r in pl):.4g}"
+    )
+    for r in sorted(hl, key=lambda r: -r["ratio"])[:10]:
+        print(
+            f"   h {r['unit_06f']} #{r['index']} leaf {r['leaf']} {r['branch']}: |dI| {r['abs_dI_measured']:.3e}, declared "
+            f"{r['declared']:.3e}, ratio {r['ratio']:.3g}"
+        )
+
+    # ---------------- tables
+    with open(out / "phase_calls.csv", "w", newline="") as f:
+        w = csv.DictWriter(f, fieldnames=list(callrows[0]))
+        w.writeheader()
+        w.writerows(callrows)
+    with open(out / "phase_leaves.csv", "w", newline="") as f:
+        w = csv.DictWriter(f, fieldnames=list(leafrows[0]))
+        w.writeheader()
+        w.writerows(leafrows)
+    scores = {
+        "captures_match_census": capok,
+        "replays_F0_hold": f0,
+        "two_trees_calls_equal": cross_ok,
+        "parent_reproduces_06f_nodes": f"{sum(rep06f)} of {len(calls)}",
+        "H1": {
+            "verdict": "holds" if H1 else "fails",
+            "points": n_pts,
+            "points_nodes": by_set["node"][0],
+            "points_dense": by_set["dense"][0],
+            "violations": n_viol,
+            "worst_ratio": wr,
+            "worst_call": f"{wc['unit_06f']} #{wc['key'][1]}",
+            "worst_point": {
+                k: wp.get(k)
+                for k in (
+                    "set",
+                    "leaf",
+                    "k",
+                    "j",
+                    "u",
+                    "delta_theta",
+                    "theta_abserr",
+                    "theta_abserr_parts",
+                )
+            },
+            "worst_dominant_part": dom(wp),
+            "parent_on_same_points_violations": x_parent,
+            "parent_on_same_points_worst_ratio": x_parent_max,
+            "parent_own_points": own_parent_n,
+            "parent_own_violations": own_parent,
+            "parent_own_worst_ratio": own_parent_max,
+        },
+        "H2": {
+            "verdict": "holds" if H2 else "fails",
+            "leaves": len(hl),
+            "violations": sum(1 for r in hl if r["abs_dI_measured"] > r["declared"]),
+            "worst_ratio": wl["ratio"],
+            "worst_leaf": f"{wl['unit_06f']} #{wl['index']} leaf {wl['leaf']} ({wl['branch']})",
+            "median_ratio": med,
+            "parent_leaves": len(pl),
+            "parent_violations": len(pv),
+            "parent_worst_ratio": wpl["ratio"],
+        },
+        "split_by_dominant_part": split_out,
+    }
+    (out / "scores.json").write_text(json.dumps(scores, indent=1))
+    for p in ("phase_calls.csv", "phase_leaves.csv", "scores.json"):
+        print(f"wrote out/{p} sha256 {sha256(out / p)}")
+
+
+if __name__ == "__main__":
+    main()
diff -ruN -x o state/scripts_06f_reference/scripts/cross06h.py scripts/cross06h.py
--- state/scripts_06f_reference/scripts/cross06h.py	1970-01-01 01:00:00
+++ scripts/cross06h.py	2026-11-01 00:29:38
@@ -0,0 +1,197 @@
+"""levin-phase-floor prompt 06h section 5, the phase re-measurement: one tree's code scored at the
+other tree's points. New in 06h.
+
+H1 is scored on h's points: every node of every returned leaf of h's replay, and the dense sample.
+"The parent's declaration is scored on the same points beside it" (prompt 06h section 5): where h's
+and the parent's returned leaves differ, the node sets differ, so each tree's replay scores its own
+nodes, and this script scores the tree on PYTHONPATH (normally ``p``) at the **other** tree's points
+(normally ``h``'s), with its own captured group: production's ``theta_mod_2pi(u)`` and
+``theta_abserr(u)`` of this tree, against the other tree's stored reference at the exact e^u
+(replay06f.py's ``ref_exact_mod_2pi``, 40 digits, reduced into (-pi, pi]). The reference is a
+function of the group's orders, coefficients and signs alone, which both trees' captures share
+(checked here: the two groups' coefficients, signs and orders are equal, and the two calls' spans
+are equal bit for bit). No mpmath Bessel function is evaluated here; the difference is reduced at
+30 digits, as in the replay.
+
+The dense sample is the same in both trees when the spans are equal (one seed, one span): this
+script also checks that the other tree's dense points and references equal this tree's own, bit
+for bit and digit for digit.
+
+Writes OUT_DIR/<this unit>_<index>/cross.json (summary) and rows.json.gz (one row per point).
+
+Usage: PYTHONPATH=<tree T>:<scripts> python -B cross06h.py CAPTURE_JSON UNIT INDEX OWN_REPLAY_DIR
+       OTHER_REPLAY_DIR OUT_DIR
+(OWN_REPLAY_DIR and OTHER_REPLAY_DIR are the two trees' out/replay_<tree>/<unit>_<index> dirs.)
+"""
+
+import gzip
+import hashlib
+import json
+import os
+import socket
+import sys
+from datetime import datetime, timezone
+from pathlib import Path
+
+HERE = Path(__file__).resolve().parent
+sys.path.insert(0, str(HERE))
+from prov import TREES, sha256, tree_state  # noqa: E402
+from replay06f import MP_DPS, jdump, load_capture, wrap  # noqa: E402
+
+
+def main():
+    cap_json, uid, index, own_dir, other_dir, out_dir = sys.argv[1:7]
+    index = int(index)
+    own_dir, other_dir = Path(own_dir), Path(other_dir)
+    import mpmath as mp
+
+    import AdaptiveLevin.levin_quadrature as LQ
+
+    tree = LQ.__file__.split("/AdaptiveLevin/")[0]
+    head, status = tree_state(tree)
+    names = [n for n, (t, _s) in TREES.items() if str(t) == tree]
+    tree_name = names[0] if len(names) == 1 else None
+    hdr = {
+        "title": "levin-phase-floor 06h: one tree's code scored at the other tree's points",
+        "written": datetime.now(timezone.utc).isoformat(timespec="seconds"),
+        "host": socket.gethostname(),
+        "pid": os.getpid(),
+        "script": "cross06h.py",
+        "script_sha256": sha256(Path(__file__).resolve()),
+        "replay06f_sha256": sha256(HERE / "replay06f.py"),
+        "prov_sha256": sha256(HERE / "prov.py"),
+        "tree": tree,
+        "tree_name": tree_name,
+        "tree_head": head,
+        "tree_status_short": status,
+        "three_bessel_integrals_sha256": sha256(
+            Path(tree) / "LiouvilleGreen" / "three_bessel_integrals.py"
+        ),
+        "capture_json": cap_json,
+        "capture_json_sha256": sha256(cap_json),
+        "unit": uid,
+        "index": index,
+        "own_replay_dir": str(own_dir),
+        "other_replay_dir": str(other_dir),
+        "inputs_sha256": {
+            str(p): sha256(p)
+            for p in (
+                own_dir / "result.json",
+                own_dir / "dense.json.gz",
+                other_dir / "result.json",
+                other_dir / "nodes.json.gz",
+                other_dir / "dense.json.gz",
+            )
+        },
+        "PYTHONPATH": os.environ.get("PYTHONPATH"),
+        "dont_write_bytecode": sys.dont_write_bytecode,
+    }
+    if (
+        tree_name is None
+        or head != TREES[tree_name][1]
+        or status.strip()
+        or not uid.startswith(tree_name + "-")
+    ):
+        raise SystemExit(f"tree evidence does not hold: {hdr}")
+    rec, cap = load_capture(cap_json, uid, index)
+    hdr["capture_blob_sha256"] = cap["sha256"]
+    group = rec["theta"]["theta_mod_2pi"].__self__
+    own = json.loads((own_dir / "result.json").read_text())
+    other = json.loads((other_dir / "result.json").read_text())
+    og = other["M2"]["group"]
+    checks = {
+        "spans_equal": [x["hex"] for x in own["x_span"]]
+        == [x["hex"] for x in other["x_span"]],
+        "coefficients_equal": [float(c).hex() for c in group.coefficients]
+        == [float(c).hex() for c in og["coefficients"]],
+        "signs_equal": list(map(float, group.signs)) == list(map(float, og["signs"])),
+        "orders_equal": [float(p.nu) for p in group.phases]
+        == [float(n) for n in og["nu"]],
+        "K_equal": float(group.K).hex() == float(og["K"]).hex(),
+    }
+    own_dense = json.load(gzip.open(own_dir / "dense.json.gz", "rt"))
+    other_dense = json.load(gzip.open(other_dir / "dense.json.gz", "rt"))
+    checks["dense_points_equal"] = [r["u"] for r in own_dense] == [
+        r["u"] for r in other_dense
+    ]
+    checks["dense_references_equal"] = [r["ref_exact_mod_2pi"] for r in own_dense] == [
+        r["ref_exact_mod_2pi"] for r in other_dense
+    ]
+    if not all(
+        checks[k]
+        for k in ("coefficients_equal", "signs_equal", "orders_equal", "K_equal")
+    ):
+        raise SystemExit(f"the two trees' groups differ: {checks}")
+    mp.mp.dps = MP_DPS
+    rows = []
+    for name, kind in (("nodes.json.gz", "node"), ("dense.json.gz", "dense")):
+        for r in json.load(gzip.open(other_dir / name, "rt")):
+            u = float.fromhex(r["u"])
+            th = float(group.theta_mod_2pi(u))
+            ta = float(group.theta_abserr(u))
+            d = float(wrap(mp, mp.mpf(th) - mp.mpf(r["ref_exact_mod_2pi"])))
+            parts = None
+            if hasattr(group, "_declared_error_parts"):
+                parts = [float(x) for x in group._declared_error_parts(u)]
+            rows.append(
+                {
+                    "set": kind,
+                    "leaf_other": r.get("leaf"),
+                    "k": r.get("k", r.get("j")),
+                    "u": r["u"],
+                    "theta_mod_2pi": th.hex(),
+                    "delta_theta": d,
+                    "theta_abserr": ta,
+                    "ratio": abs(d) / ta if ta > 0 else None,
+                    "theta_abserr_parts": parts,
+                    "other_theta_mod_2pi": r["theta_mod_2pi"],
+                    "other_delta_theta": r["delta_theta"],
+                    "other_theta_abserr": r["theta_abserr"],
+                    "other_ratio": r["ratio"],
+                }
+            )
+    odir = Path(out_dir) / f"{uid}_{index}"
+    odir.mkdir(parents=True, exist_ok=False)
+    rows_sha = jdump(odir / "rows.json.gz", rows)
+    summ = {}
+    for kind in ("node", "dense", "all"):
+        sel = [r for r in rows if kind == "all" or r["set"] == kind]
+        rat = [r["ratio"] for r in sel if r["ratio"] is not None]
+        summ[kind] = {
+            "n": len(sel),
+            "n_violating": sum(1 for x in rat if x > 1.0),
+            "max_ratio": max(rat) if rat else None,
+            "n_other_violating": sum(
+                1
+                for r in sel
+                if r["other_ratio"] is not None and r["other_ratio"] > 1.0
+            ),
+            "max_other_ratio": max(
+                (r["other_ratio"] for r in sel if r["other_ratio"] is not None),
+                default=None,
+            ),
+        }
+    out = {
+        "header": hdr,
+        "checks": checks,
+        "summary": summ,
+        "rows_sha256": rows_sha,
+    }
+    (odir / "cross.json").write_text(json.dumps(out, indent=1))
+    print(
+        json.dumps(
+            {
+                "unit": uid,
+                "index": index,
+                "checks": checks,
+                "all": summ["all"],
+                "digest": hashlib.sha256(rows_sha.encode()).hexdigest(),
+            }
+        ),
+        flush=True,
+    )
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
diff -ruN -x o state/scripts_06f_reference/scripts/launch_06h.py scripts/launch_06h.py
--- state/scripts_06f_reference/scripts/launch_06h.py	1970-01-01 01:00:00
+++ scripts/launch_06h.py	2026-11-01 00:28:08
@@ -0,0 +1,104 @@
+"""levin-phase-floor prompt 06h section 5, the phase re-measurement: launch run_06h.py as one registered,
+detached run (campaign levin-phase-floor, prompt 06h, slug ``phase``). Copied from 06f's
+launch_06f.py and changed only in its script, slug, purpose, scope and unit count:
+``runregistrykit.begin`` first (manifest, script run_06h.py), then ``nohup sh -c '<driver>; exit
+$?'`` in a new session, stdin from /dev/null, stdout and stderr into the run directory, the sh pid
+recorded with ``Run.heartbeat(pid=...)``; the driver replaces it with its own. New in 06h.
+Usage (from var/levin-phase-floor-06h/phase/): python -B scripts/launch_06h.py"""
+
+import json
+import os
+import shlex
+import subprocess
+import sys
+from pathlib import Path
+
+import runregistrykit
+
+HERE = Path(__file__).resolve().parent
+ROOT = HERE.parent
+PYTHON = "/Users/ds283/Documents/Code/SecondaryGWKit/venv/bin/python"
+SCRIPT = HERE / "run_06h.py"
+N_CALLS = len(json.loads((ROOT / "out" / "sample" / "selection_h.json").read_text()))
+assert N_CALLS == len(
+    json.loads((ROOT / "out" / "sample" / "selection_p.json").read_text())
+)
+PURPOSE = (
+    "levin-phase-floor prompt 06h section 5 on the Mac Studio (mps026298; Python 3.13.16): the phase "
+    "re-measurement, 06f's M2 items 1 and 4 repeated at 06h's code (H1, H2). Captures 06f's 20 M2 calls "
+    "by 06e's x1_capture.py (06h's copy) at the parent p (worktree "
+    "/Users/ds283/Documents/Code/SecondaryGWKit-lpf06h-2c325f5, 2c325f5, code 06e's; each capture checked "
+    "bit for bit against 06e's census checkpoint a0dc4d7f) and at h (worktree "
+    "/Users/ds283/Documents/Code/SecondaryGWKit-lpf06h-c1ec3b2, dispatch SHA c1ec3b2, code 7172a8f + "
+    "ac1c6f4; each checked against 06h's census checkpoint), reading 06's certified scratch copy of A3 v2 "
+    "read-only (fingerprint 0e32f24a) on a stand-in ShardedPool; the method check at the exact e^u before "
+    "any scoring; replays each call in its own process in its own tree with 06f's pass-throughs, with "
+    "mpmath phase references at 30 digits at the exact e^u (and at 06f's x_hat), at every node of every "
+    "returned leaf and 06f's seeded dense sample of 1,000 points per call; each tree's code scored at the "
+    "other's points; the reference re-checked at 50 digits at h's worst point. At most six processes; "
+    "Ray-free, no lock, no store built, no code changed"
+)
+SCOPE = (
+    f"out/sample/selection_p.json and selection_h.json ({N_CALLS} calls each, 06f's M2 sample, seed "
+    "20261031); outputs under var/levin-phase-floor-06h/phase/ (state/capture_p, state/capture_h, "
+    "out/capture_p.json, out/capture_h.json, out/replay_p, out/replay_h, out/replay_logs, out/cross, "
+    "out/cross_logs, out/cmd/30-33)"
+)
+HEARTBEAT_MEANS = (
+    "Refreshed by the launcher once with the sh pid, by the driver at start with its own pid, at each "
+    "stage's and each child's start and end, and every 60 s by a thread of the driver while its process lives."
+)
+
+
+def main():
+    argv = [PYTHON, "-B", str(SCRIPT), "--run-dir", "<run dir>"]
+    run = runregistrykit.begin(
+        campaign="levin-phase-floor",
+        prompt="06h",
+        slug="phase",
+        purpose=PURPOSE,
+        argv=argv,
+        cwd=str(ROOT),
+        script=str(SCRIPT),
+        unit="units",
+        expected_units=2 + 1 + 2 * N_CALLS + 2 * N_CALLS + 1,
+        checkpoint=True,
+        results=None,
+        scope=SCOPE,
+        heartbeat_means=HEARTBEAT_MEANS,
+    )
+    env = dict(os.environ)
+    env.pop("PYTHONPATH", None)
+    env["PYTHONDONTWRITEBYTECODE"] = "1"
+    stdout = open(run.stdout_path, "ab")
+    stderr = open(run.stderr_path, "ab")
+    command = (
+        " ".join(
+            shlex.quote(a) for a in [PYTHON, "-B", str(SCRIPT), "--run-dir", run.path]
+        )
+        + "; exit $?"
+    )
+    child = subprocess.Popen(
+        ["nohup", "sh", "-c", command],
+        cwd=str(ROOT),
+        env=env,
+        stdin=subprocess.DEVNULL,
+        stdout=stdout,
+        stderr=stderr,
+        start_new_session=True,
+        close_fds=True,
+    )
+    stdout.close()
+    stderr.close()
+    run.heartbeat(pid=child.pid, stage="launched (detached sh started)")
+    print(f"run id      {run.id}")
+    print(f"run dir     {run.path}")
+    print(f"script      {SCRIPT}")
+    print(f"sh pid      {child.pid}")
+    print(f"command     {command}")
+    print(f"launcher    pid {os.getpid()}, exiting without waiting")
+
+
+if __name__ == "__main__":
+    main()
+    sys.exit(0)
diff -ruN -x o state/scripts_06f_reference/scripts/method_check_06f.py scripts/method_check_06f.py
--- state/scripts_06f_reference/scripts/method_check_06f.py	2026-10-31 23:50:48
+++ scripts/method_check_06f.py	2026-11-01 00:29:38
@@ -1,5 +1,20 @@
-"""levin-phase-floor prompt 06f section 3, item 1's method check. New in 06f.
+"""levin-phase-floor prompt 06h section 5, the phase re-measurement's method check: copied from prompt
+06f's scripts/method_check_06f.py (a record, not edited; its copy is in
+state/scripts_06f_reference/scripts/), adapted to the reference at the exact e^u (prompt 06h
+section 2), each change marked "prompt 06h":
+- the tree is the one on PYTHONPATH, one of prov.TREES, and the capture JSON is that tree's;
+- the group's check at the call's lower endpoint is made at the **exact** e^u (mp.exp of the
+  double u at the working precision), at 30 and at 50 digits, which must agree to 1e-25 (06f: at
+  the double x_hat); the error at x_hat is printed beside it;
+- the second reference formula, arg H1_nu(y) + pi/2 (06f's review, orch_m2.py; prompt 06h section 2
