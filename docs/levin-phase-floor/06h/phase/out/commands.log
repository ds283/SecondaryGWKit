+                float(r["theta_abserr"]).hex(),
+            )
+            for r in c["nodes_p"]
+        ]
+        rep06f.append(a == b)
+        if a != b:
+            print(
+                f"   {c['unit_06f']} #{c['key'][1]}: differs ({len(a)} vs {len(b)} nodes)"
