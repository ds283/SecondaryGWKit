>         ps = sum(p["projection"][k]["with_margin_s"] for k in ("qawo_r1", "qawo_r2", "fcc_r1", "fcc_r2"))
>         jobs.append({"name": sid, "pythonpath": f"{TREE}:{HERE / 'capture'}", "requires": str(Path(x["pickle"]).relative_to(ROOT)),
