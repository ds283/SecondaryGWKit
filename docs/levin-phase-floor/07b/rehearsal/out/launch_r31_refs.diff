>     if len(jobs) != 7:
>         raise SystemExit(f"{len(jobs)} calls, not 7")
>     jobs.sort(key=lambda j: (j["projected_s"], j["name"]))
>     return {"label": "r31-refs", "backstop_s": 14400.0, "check_after_s": 1800.0,
>             "stages": [{"name": "readings", "max_parallel": 1, "jobs": jobs}]}
