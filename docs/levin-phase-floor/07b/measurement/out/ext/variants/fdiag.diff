+        for rate in (rate_fns or []):
+            vals = np.abs(np.array([float(rate(x)) for x in grid]))
+            q = float(np.max(vals) / np.min(vals)) if np.min(vals) > 0.0 else float("inf")
+            worst = max(worst, q)
+        ok = worst <= _F_RANGE_07B
+        if _MEASURE_07B is not None:
