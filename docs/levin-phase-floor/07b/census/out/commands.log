+
+def _r07b_summary(lst, result):
+    """prompt 07b: the checkpoint's summary of one call's rate-rule evaluations (the instrument's records, each
+    (lo, hi, depth, rule, q, refused, n_edge_ends) or None where it could not be recorded)."""
+    out = {"n_evaluated": 0, "n_unrecorded": 0, "by_rule": {}, "refused_by_depth": {}, "n_depth_unknown": 0}
+    qmax, qmin = {}, {}
+    for e in lst:
+        if e is None:
+            out["n_unrecorded"] += 1
+            continue
+        _lo, _hi, dep, rule, q, refused, _ne = e
+        out["n_evaluated"] += 1
+        key = str(rule)
+        b = out["by_rule"].setdefault(key, {"evaluated": 0, "refused": 0})
+        b["evaluated"] += 1
+        if dep < 0:
+            out["n_depth_unknown"] += 1
+        if refused:
+            b["refused"] += 1
+            out["refused_by_depth"][str(dep)] = out["refused_by_depth"].get(str(dep), 0) + 1
+            qmax[key] = q if key not in qmax else max(qmax[key], q)
+            qmin[key] = q if key not in qmin else min(qmin[key], q)
+    out["q_max_refused"] = {k: fx(v) for k, v in qmax.items()}
+    out["q_min_refused"] = {k: fx(v) for k, v in qmin.items()}
+    re_ = result.get("num_edge_rule_refusals")
+    rr_ = result.get("num_range_rule_refusals")
+    out["counts_equal_result"] = (
+        re_ is not None and rr_ is not None and out["n_unrecorded"] == 0
+        and out["by_rule"].get("edge", {}).get("refused", 0) == int(re_)
+        and out["by_rule"].get("range", {}).get("refused", 0) == int(rr_)
+    )
+    return out
+
