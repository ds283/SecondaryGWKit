+    S["where_the_fix_acts"] = tab
+    # the instrument's aggregates
+    ev, rf, qr, qp, wd = Counter(), Counter(), Counter(), Counter(), Counter()
+    edge_list, n_unrec, n_uneq = [], 0, 0
+    for u in U:
