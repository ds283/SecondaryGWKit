+           f"the parent's AdaptiveLevin/levin_quadrature.py installed in place of h's by variant_loader (git show 7b82a0cd, "
+           f"sha256 {LQ_SHA256_07BPARENT[:8]}, byte-identical to 07a's census module; {PARENT_VARIANT_07B}): 06k's "
+           f"100 K0 census units (docs/levin-phase-floor/06l/out/k0/units.json, sha256 {sha256(K0_UNITS)[:8]}) re-run with "
+           "07a's census harness as changed for 07b, then each unit compared bit for bit with 07a's census "
+           f"({RUN07A.name}, checkpoint {CHECKPOINT07A_SHA256[:8]}) with 07b's new keys set aside. Then the same 100 units "
+           f"at h (levin_quadrature.py {LQ_SHA256_07BH[:8]}) for the census's cost projection, compared call by call with "
+           "07a's; (3) one unit where the fix acts (h-1e-8-3-14501, fixed by name) and one where it does not (chosen from "
+           "the K0 units at h by select_u0_units_07b.py's rule) run at h with the instruments on and off, compared bit for "
+           "bit; and (4) the first unit run twice at h in two fresh workers and compared bit for bit. Every unit reads 06's "
+           f"certified scratch copy of A3 v2 read-only (fingerprint {A3V2_DIGEST[:8]}) on a stand-in ShardedPool, 300 s per "
+           "unit. No census. At most six computing processes; Ray-free, no lock, no store built, nothing written in a tree"),
+}
+SCOPES = {  # prompt 07a
+    "k0": ("docs/levin-phase-floor/06l/out/k0/units.json (100 units, in the tree h, read only), state/w0c3_units.json (2 "
+           "units) and state/w0c4_units.json (1 unit), the last two written by the run's stage 5; outputs under "
+           "var/levin-phase-floor-07a/census/: state/k0/parent, state/k0/h, state/w0c3/on, state/w0c3/off, state/w0c4/run1, "
+           "state/w0c4/run2, out/k0/, out/w0c3/, out/w0c4/, out/cmd/k0"),
+}
+
+SCOPES["references"] = ("4 captured calls (out/refs/inputs.json), up to 16 readings; outputs out/refs/readings/, "  # prompt 07a
+                         "out/cmd/references")
+SCOPES = {  # prompt 07b
+    "k0": ("docs/levin-phase-floor/06l/out/k0/units.json (100 units, in the tree h, read only), state/u0c3_units.json (2 "
+           "units) and state/u0c4_units.json (1 unit), the last two written by the run's stage 5; outputs under "
+           "var/levin-phase-floor-07b/census/: state/k0/parent, state/k0/h, state/u0c3/on, state/u0c3/off, state/u0c4/run1, "
+           "state/u0c4/run2, out/k0/, out/u0c3/, out/u0c4/, out/cmd/k0"),
+}
+HEARTBEAT_MEANS = ("Refreshed by the launcher once with the sh pid, by the driver at start with its own pid, at each "
+                   "command's start and end, and every 60 s by a thread of the driver while its process lives.")
+
+
+def main():
+    label = sys.argv[1] if len(sys.argv) > 1 else None
+    if label not in PURPOSES:
+        raise SystemExit(f"usage: launch_07a.py {'|'.join(PURPOSES)}")
+    plan = {"k0": plan_k0}[label]()  # prompt 07a; prompt 07b: k0 only
+    plan_p = ROOT / "state" / f"plan_{label}.json"
+    if plan_p.exists():
+        raise SystemExit(f"{plan_p} exists; not overwritten")
+    plan_p.write_text(json.dumps(plan, indent=1))
+    n = sum(len(st["jobs"]) for st in plan["stages"])
+    argv = [PYTHON, "-B", str(SCRIPT), "--run-dir", "<run dir>", "--plan", str(plan_p)]
+    run = runregistrykit.begin(
+        campaign="levin-phase-floor", prompt="07b", slug=label, purpose=PURPOSES[label], argv=argv, cwd=str(ROOT),  # prompt 07b
+        script=str(SCRIPT), unit="commands", expected_units=n, checkpoint=True, results=None, scope=SCOPES[label],
+        heartbeat_means=HEARTBEAT_MEANS)
+    env = dict(os.environ)
+    env.pop("PYTHONPATH", None)
+    env["PYTHONDONTWRITEBYTECODE"] = "1"
+    stdout = open(run.stdout_path, "ab")
+    stderr = open(run.stderr_path, "ab")
+    command = " ".join(shlex.quote(a) for a in [PYTHON, "-B", str(SCRIPT), "--run-dir", run.path, "--plan", str(plan_p)]) + "; exit $?"
+    child = subprocess.Popen(["nohup", "sh", "-c", command], cwd=str(ROOT), env=env, stdin=subprocess.DEVNULL,
+                             stdout=stdout, stderr=stderr, start_new_session=True, close_fds=True)
+    stdout.close()
+    stderr.close()
+    run.heartbeat(pid=child.pid, stage="launched (detached sh started)")
+    print(f"run id      {run.id}")
+    print(f"run dir     {run.path}")
+    print(f"plan        {plan_p} ({n} commands)")
+    print(f"sh pid      {child.pid}")
+    print(f"command     {command}")
+    print(f"launcher    pid {os.getpid()}, exiting without waiting")
+
+
+if __name__ == "__main__":
+    main()
+    sys.exit(0)
