+                C[f"{u['rtol']}|{k_}"] += v_
+        edge_list += [dict(e, unit=u["unit"]) for e in r7.get("edge_refusals") or []]
+        n_unrec += r7.get("n_unrecorded") or 0
+        n_uneq += r7.get("n_counts_unequal") or 0
+    S["refused_leaves"] = {"evaluated_by_rtol_kind_rule_depth": dict(ev), "refused_by_rtol_kind_rule_depth": dict(rf),
+                           "q_refused_log10_bins": dict(qr), "q_passed_log10_bins": dict(qp), "width_refused_log10": dict(wd),
+                           "n_edge_refusals": len(edge_list), "edge_refusals": edge_list,
+                           "edge_q": q([e["q"] for e in edge_list]), "edge_depth": dict(Counter(e["depth"] for e in edge_list)),
+                           "instrument_unrecorded": n_unrec, "calls_instrument_counts_unequal_result": n_uneq,
+                           "totals": {"edge": sum(c["num_edge_rule_refusals"] or 0 for c in calls),
+                                      "range": sum(c["num_range_rule_refusals"] or 0 for c in calls)}}
+    # ---------------- descriptive: convergence, abserr, regions, totals
+    conv = Counter((c["rtol"], c["kind"], str(c["converged"][1]), str(c["converged"][0])) for c in calls)
+    S["converged_07a_to_07b"] = {"|".join(k): v for k, v in sorted(conv.items())}
+    d20 = {(u["unit"], x["kind"], x["index"]): x for u in U for x in u.get("depth20") or []}
+    newly = [c for c in calls if c["converged"][1] is True and c["converged"][0] is False]
+    regained = [c for c in calls if c["converged"][1] is False and c["converged"][0] is True]
+    S["newly_unconverged"] = {"n": len(newly), "list": [
+        {**{k: c[k] for k in ("unit", "kind", "index", "label", "num_edge_rule_refusals", "num_range_rule_refusals", "num_regions", "max_depth")},
+         **{k: (d20.get((c["unit"], c["kind"], c["index"])) or {}).get(k) for k in
+            ("n_depth20", "routes", "descends_from_refused", "routes_descending", "refused_ancestor_depths", "untrusted")},
+         "abserr_over_07a": float(F(c["abserr"][0]) / F(c["abserr"][1])) if F(c["abserr"][1]) else None,
+         "value_move_over_abserr_07a": float(abs(F(c["value"][0]) - F(c["value"][1])) / F(c["abserr"][1])) if F(c["abserr"][1]) else None}
+        for c in newly]}
+    S["newly_converged"] = {"n": len(regained), "list": [{k: c[k] for k in ("unit", "kind", "index", "label", "num_regions", "max_depth")}
+                                                          for c in regained]}
+    S["unconverged_by_code"] = {code: {"|".join(k): v for k, v in sorted(cc.items())} for code, cc in unconv.items()}
+    ratios = defaultdict(list)
+    moves = defaultdict(list)
+    for c in calls:
+        if F(c["abserr"][1]) and F(c["abserr"][0]):
+            a = "untouched" if c["class"] == "untouched" else "acted"
+            ratios[f"{c['rtol']}|{c['kind']}|{a}"].append(float(F(c["abserr"][0]) / F(c["abserr"][1])))
+            moves[f"{c['rtol']}|{c['kind']}|{a}"].append(float(abs(F(c["value"][0]) - F(c["value"][1])) / F(c["abserr"][1])))
+    S["abserr_ratio_07b_over_07a"] = {k: q(v) for k, v in sorted(ratios.items())}
+    S["abserr_ratio_bins"] = {k: dict(Counter("<0.5" if x < 0.5 else "[0.5,1)" if x < 1 else "1" if x == 1 else "(1,2]" if x <= 2 else ">2"
+                                              for x in v)) for k, v in sorted(ratios.items())}
+    S["value_move_over_abserr_07a"] = {k: q(v) for k, v in sorted(moves.items())}
+    S["value_move_over_abserr_07a_gt_1"] = {k: sum(1 for x in v if x > 1) for k, v in sorted(moves.items())}
+    big = [c for c in calls if F(c["abserr"][1]) and abs(F(c["value"][0]) - F(c["value"][1])) > F(c["abserr"][1])]
+    S["calls_moved_beyond_abserr_07a"] = {"n": len(big), "by": dict(Counter(f"{c['rtol']}|{c['kind']}" for c in big)),
+                                          "beyond_both": sum(1 for c in big if abs(F(c["value"][0]) - F(c["value"][1])) > F(c["abserr"][0])),
+                                          "list": [{k: c[k] for k in ("unit", "kind", "index", "value", "abserr", "converged")} for c in big][:200]}
+    mv = {"n": 0, "over_tae07a": [], "conv": []}
+    for u in U:
+        t, ta, tc = u.get("total"), u.get("total_abserr"), u.get("total_converged")
+        if not t or t[0] is None:
+            continue
+        if t[0] != t[1] or ta[0] != ta[1]:
+            mv["n"] += 1
+            if F(ta[1]):
+                mv["over_tae07a"].append(float(abs(F(t[0]) - F(t[1])) / F(ta[1])))
+        if tc[0] != tc[1]:
+            mv["conv"].append({"unit": u["unit"], "07b_07a": tc})
+    S["row_totals"] = {"rows_differing": mv["n"], "move_over_total_abserr_07a": q(mv["over_tae07a"]),
+                       "n_gt_1": sum(1 for x in mv["over_tae07a"] if x > 1), "total_converged_changes": mv["conv"]}
+    S["row_depth_20"] = {rt: [sum(1 for u in U if u["rtol"] == rt and u.get("row_depth") and u["row_depth"][j] == 20) for j in (0, 1)]
+                         for rt in ("1e-7", "1e-8")}
+    S["cost"] = json.loads(COST.read_text()) | {
+        "unit_time_s": {rt: [sum(u["time_s"][j] for u in U if u["rtol"] == rt) for j in (0, 1)] for rt in ("1e-7", "1e-8")},
+        "unit_wall_s_max": [max((u["wall_s"][0] or 0) for u in U), max((u["wall_s"][1] or 0) for u in U)],
+        "n_solves_07b": sum(u.get("n_solves") or 0 for u in U)}
+    S["cost"].pop("header", None)
+    out_p.parent.mkdir(parents=True, exist_ok=True)
+    out_p.write_text(json.dumps(S, indent=1, default=str))
+    brief = {k: S[k] for k in ("statuses", "n_calls", "route_errors", "scan_07_errors")}
+    brief["U1"] = S["U1"]
+    for k in ("U2", "U3"):
+        brief[k] = {kk: vv for kk, vv in S[k].items() if kk not in ("levin_leaves", "violations")}
+    brief["U4"] = S["U4"]
+    brief["U5"] = {kk: vv for kk, vv in S["U5"].items() if kk != "calls"}
+    brief["U6"] = {kk: vv for kk, vv in S["U6"].items() if kk != "ratios_07b_07a_06b_converged"}
+    brief["U7"] = S["U7"]
+    brief["U8"] = S["U8"]
+    brief["refusals_totals"] = S["refused_leaves"]["totals"]
+    brief["edge"] = {k: S["refused_leaves"][k] for k in ("n_edge_refusals", "edge_q", "edge_depth")}
+    brief["converged_07a_to_07b"] = S["converged_07a_to_07b"]
+    brief["newly_unconverged_n"] = S["newly_unconverged"]["n"]
+    brief["newly_converged_n"] = S["newly_converged"]["n"]
+    brief["row_totals"] = {k: v for k, v in S["row_totals"].items()}
+    print(json.dumps(brief, indent=1, default=str))
+    print(f"wrote {out_p} sha256 {sha256(out_p)}")
+
+
+if __name__ == "__main__":
+    main()
diff -ruN /Users/ds283/Documents/Code/SecondaryGWKit-lpf07b-0a103b5/docs/levin-phase-floor/07a/census/scripts/u0a_imports_07b.py scripts/u0a_imports_07b.py
--- /Users/ds283/Documents/Code/SecondaryGWKit-lpf07b-0a103b5/docs/levin-phase-floor/07a/census/scripts/u0a_imports_07b.py	1970-01-01 01:00:00
+++ scripts/u0a_imports_07b.py	2026-11-16 20:39:33
@@ -0,0 +1,82 @@
+"""levin-phase-floor prompt 07b section 6, Gate U0's first clause, the files loaded: copied from 07a's w0a_imports_07a.py
+(a record, not edited), changed where marked "prompt 07b": the K0 run at the parent (in h, 0a103b5a, with 7b82a0cd's
+module installed) executes 07a's code if no file h loaded differs from 07a's census tree 4bf50d34 except the two
+LiouvilleGreen modules whose AST without docstrings is equal (out/u0/u0a_ast.txt), h's own levin_quadrature.py is not
+loaded, the variant loaded is the parent's file (4ea1948b..., 07a's), and nothing loaded differs between the parent
+7b82a0cd and h but levin_quadrature.py (replaced). 07a's text follows.
+
+levin-phase-floor prompt 07a section 6, Gate W0's first clause and the parent's install: the files of tree h that the
+K0 run's workers loaded (each worker's ``bye``: ``modules_own_tree``, and the module counted under the root ``variant``),
+against ``git diff --name-only dadd63a0 4bf50d34 -- . ':!docs' ':!prompts'`` (the parent against h) and against
+``git diff --name-only e182bc7a dadd63a0 -- . ':!docs' ':!prompts'`` (S0', 07's census tree against the parent). New in
+07a, after 07's v0a_imports_07.py (a record, not edited). Read only.
+
+The K0 run executes the parent's code if: no file h loaded differs from the parent's except the two LiouvilleGreen modules
+whose AST without docstrings is equal (out/w0/w0a_ast_lg.txt); h's own AdaptiveLevin/levin_quadrature.py is not among the
+files loaded; the variant loaded is the parent's file (its SHA-256 4e5da371...); and nothing the K0 workers loaded differs
+between 07's census tree e182bc7a and the parent (S0').
+
+Usage: python -B w0a_imports_07a.py RUN_K0_DIR OUT_TXT
+"""
+import json
+import subprocess
+import sys
+from pathlib import Path
+
+HERE = Path(__file__).resolve().parent
+sys.path.insert(0, str(HERE))
+from prov import H_SHA, H_TREE, LQ_SHA256_07APARENT, PARENT_SHA_07A, PARENT_VARIANT_07A, header, sha256  # noqa: E402
+from prov import H07A_SHA, LQ_SHA256_07BPARENT, PARENT_SHA_07B, PARENT_VARIANT_07B  # noqa: E402  prompt 07b
+
+AST_EQUAL = {"LiouvilleGreen/bessel_phase.py", "LiouvilleGreen/three_bessel_integrals.py"}  # out/w0/w0a_ast_lg.txt; prompt 07b: out/u0/u0a_ast.txt
+
+
+def git_names(a, b):
+    return subprocess.run(["git", "--no-optional-locks", "-C", str(H_TREE), "diff", "--name-only", a, b, "--", ".",
+                           ":!docs", ":!prompts"], capture_output=True, text=True, check=True).stdout.split()
+
+
+def main():
+    run_dir, out_p = Path(sys.argv[1]), Path(sys.argv[2])
+    files = set()
+    variants = set()
+    n_workers = 0
+    for wdir in sorted(p for p in run_dir.iterdir() if p.is_dir()):
+        for line in open(wdir / "emit.jsonl"):
+            m = json.loads(line)
+            if m["kind"] == "bye":
+                n_workers += 1
+                for _name, f in m["modules_own_tree"]:
+                    files.add(str(Path(f).resolve().relative_to(H_TREE)))
+            if m["kind"] == "hello":
+                v = m["evidence"].get("variant_06k") or {}
+                variants.add((v.get("path"), v.get("sha256_now")))
+    diff_ph = git_names(PARENT_SHA_07B, H_SHA)  # prompt 07b: the parent 7b82a0cd against h
+    diff_s0 = git_names(H07A_SHA, H_SHA)  # prompt 07b: 07a's census tree 4bf50d34 against h (S0' and the code commit)
+    loaded = files | {"main.py"}  # main.py is read by the harness (test_main_plumbing reads it with ast), not imported
+    inter_ph = sorted(set(diff_ph) & loaded)
+    inter_s0 = sorted(set(diff_s0) & loaded)
+    lq_loaded = "AdaptiveLevin/levin_quadrature.py" in files
+    variant_ok = variants == {(str(PARENT_VARIANT_07B.resolve()), LQ_SHA256_07BPARENT)}  # prompt 07b
+    ok = not inter_ph and not lq_loaded and variant_ok and set(inter_s0) <= AST_EQUAL  # prompt 07b
+    lines = header(Path(__file__).resolve(), "levin-phase-floor 07b: Gate U0 (1), the files of h the K0 workers loaded",
+                   [PARENT_VARIANT_07B])  # prompt 07b
+    lines.append(f"# workers with a bye: {n_workers}; distinct files of h loaded: {len(files)}")
+    lines.append(f"# variants installed (path, sha256 at hello): {sorted(variants)}; the parent's: {variant_ok}")
+    lines.append(f"# h's own AdaptiveLevin/levin_quadrature.py among the files loaded: {lq_loaded}")
+    lines.append(f"# git diff --name-only {PARENT_SHA_07B[:8]} {H_SHA[:8]} -- . ':!docs' ':!prompts': {diff_ph}")  # prompt 07b
+    lines.append(f"# files both changed (parent to h) and loaded: {inter_ph} (none expected: levin_quadrature.py is replaced)")
+    lines.append(f"# git diff --name-only {H07A_SHA[:8]} {H_SHA[:8]} -- . ':!docs' ':!prompts' (07a's census tree to h): {diff_s0}; "
+                 f"loaded among them: {inter_s0}; of these, AST-equal without docstrings (out/u0/u0a_ast.txt): "
+                 f"{sorted(set(inter_s0) & AST_EQUAL)}; other: {sorted(set(inter_s0) - AST_EQUAL)}")
+    lines.append(f"# verdict: {'HOLDS (the code the K0 workers executed is the parent code, and the parent is 07as)' if ok else 'FAILS'}")
+    lines += sorted(files)
+    out_p.parent.mkdir(parents=True, exist_ok=True)
+    out_p.write_text("\n".join(lines) + "\n")
+    print("\n".join(l for l in lines if l.startswith("#")))
+    print(f"wrote {out_p} sha256 {sha256(out_p)}")
+    return 0 if ok else 1
+
+
+if __name__ == "__main__":
+    sys.exit(main())
diff -ruN /Users/ds283/Documents/Code/SecondaryGWKit-lpf07b-0a103b5/docs/levin-phase-floor/07a/census/scripts/worker.py scripts/worker.py
--- /Users/ds283/Documents/Code/SecondaryGWKit-lpf07b-0a103b5/docs/levin-phase-floor/07a/census/scripts/worker.py	2026-11-16 14:02:55
+++ scripts/worker.py	2026-11-16 20:36:13
@@ -1,4 +1,27 @@
 """
+levin-phase-floor prompt 07b section 6: 07a's census worker (docs/levin-phase-floor/07a/census/scripts/worker.py, a record,
+byte-identical to the copy that ran on the Mac Studio), changed only where marked "prompt 07b"; no computed value changes,
+and no key 07a recorded changes (every addition is a new key), so that 07a's comparison applies with the new keys set
+aside:
+- **the tree** ``h`` (prov.TREES: the worktree at Part C's dispatch SHA 0a103b5a, code 5e19c4b6's); 07a's tree is kept
+  in prov.py by name, not used;
+- **the two counts** (07b section 1.4 and section 9.5, U1): each call's result keys ``num_edge_rule_refusals`` and
+  ``num_range_rule_refusals``, recorded in the call's summary as returned (None where the module has none: the parent);
+- **the tree evidence** also records the module's 07b markers (``_leaf_rate_rule`` and its two constants);
+- **the rate rules' instrument** (``rate_rule_07b``; section 9.5's descriptive item: "by the harness's instrument (marked
+  'prompt 07b'), each refused leaf's span, depth and q"), on when the spec's ``instrument_07b`` is true (the default:
+  the spec's ``instrument_07a``) and the module has ``_leaf_rate_rule``: a pass-through at the module attribute
+  ``_leaf_rate_rule``, installed with the timed section's other pass-throughs and for it only, records every call the
+  driver makes of it within a recorded Levin call: the leaf's span (lo, hi), its depth (read from the calling frame's
+  ``leaf``, -1 if it cannot be read), the rule applied (edge, range or none), the largest q, whether it refused, and
+  how many window-edge ends it was handed. It returns exactly what the original returns. Per call in the checkpoint
+  (``rate_rule_07b``: counts by rule, refused and passed, the largest and smallest q refused by rule, the refusals by
+  depth, and whether the instrument's refusals equal the two result counts) and per evaluation in the pickle
+  (``rate_rule_07b``: arrays). The two counts are the code's; the instrument only describes them.
