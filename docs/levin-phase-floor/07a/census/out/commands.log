+def Fx(x):
+    """A census float ({repr, hex}) as an exact Fraction; None stays None; a non-finite as a float."""
+    if x is None:
+        return None
+    v = float.fromhex(x["hex"] if isinstance(x, dict) else x)
+    return Fraction(v) if math.isfinite(v) else v
