+def _second_difference(func, x: float, step: float, lo: float, hi: float) -> float:
+    """
+    Central second difference (func(c + step) - 2 func(c) + func(c - step)) / step^2, with the
+    centre c = x moved inward, if need be, so that the stencil stays inside [lo, hi] (the rate
+    callables are not promised to be defined outside x_span). Applied to a phase rate it estimates
+    theta''' (prompt 07 section 1.1 step 3); its truncation error is step^2 |theta^(5)| / 12 and
+    its rounding error about 4 eps max|theta'| / step^2.
+    """
+    c = min(max(x, lo + step), hi - step)
+    return (func(c + step) - 2.0 * func(c) + func(c - step)) / (step * step)
+
+
+def _first_difference(func, x: float, step: float, lo: float, hi: float) -> float:
+    """Central first difference, its centre kept inside [lo, hi] as in _second_difference()."""
+    c = min(max(x, lo + step), hi - step)
+    return (func(c + step) - func(c - step)) / (2.0 * step)
+
